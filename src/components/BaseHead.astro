---
// Forked from @navfolio/theme-default's BaseHead.astro so this project can
// support a per-page canonicalUrl override (needed for cross-posted
// content) and a type override for og:type - neither is exposed as a prop
// by the vendor component, and there is no safe way to patch node_modules.
// Keep this in sync manually with upstream when the theme package updates.
import '@navfolio/theme-default/styles/global.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import FallbackImage from '../favicon_io/android-chrome-512x512.png';
import Analytics from './Analytics.astro';
import { getSiteConfig } from '../data/site';
import { getSocialImageSrc } from '../utils/social-image';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const { title, description, image, canonicalUrl, type = 'website' } = Astro.props;
const { site, fonts, theme } = await getSiteConfig();
// Open Graph wants an underscore locale (zh_TW), unlike the html lang attribute (zh-TW).
const ogLocaleByLang: Record<string, string> = { en: 'en_US', 'zh-CN': 'zh_CN', 'zh-TW': 'zh_TW' };
const ogLocale = ogLocaleByLang[theme.lang] ?? theme.lang.replace('-', '_');

const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);
const assetPath = (path: string) => `${import.meta.env.BASE_URL}${path}`;

const resolvedImage = image || FallbackImage;
const imageUrl = await getSocialImageSrc(resolvedImage);
const fontVariablesCss = createFontCss(fonts);

function stripControlChars(value: string) {
  return Array.from(value)
    .filter((char) => {
      const code = char.charCodeAt(0);
      return code > 31 && code !== 127;
    })
    .join('');
}

function normalizeFontFamilyName(fontFamily: string) {
  return stripControlChars(fontFamily)
    .trim()
    .replace(/^['"]|['"]$/g, '');
}

function toCssFontFamily(fontFamily: string) {
  const normalized = normalizeFontFamilyName(fontFamily);

  return `"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
}

function toCssString(value: string) {
  const normalized = stripControlChars(value).trim();

  return `"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
}

function resolveAssetUrl(url: string) {
  if (/^(?:https?:)?\/\//i.test(url) || url.startsWith('data:')) return url;

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
  const assetUrl = url.startsWith('/') ? url : `/${url}`;

  return `${baseUrl}${assetUrl}`;
}

function getFontFormat(url: string) {
  const extension = url.split('?')[0]?.split('#')[0]?.split('.').pop()?.toLowerCase();

  if (extension === 'woff2') return 'woff2';
  if (extension === 'woff') return 'woff';
  if (extension === 'otf') return 'opentype';

  return 'truetype';
}

function getSubsetFontUrl(fontUrl: string) {
  const queryIndex = fontUrl.search(/[?#]/);
  const suffix = queryIndex === -1 ? '' : fontUrl.slice(queryIndex);
  const path = queryIndex === -1 ? fontUrl : fontUrl.slice(0, queryIndex);
  const extensionIndex = path.lastIndexOf('.');
  const basePath = extensionIndex === -1 ? path : path.slice(0, extensionIndex);

  return `${basePath}-ui-subset.woff2${suffix}`;
}

function createFontCss(fonts: { en: string; code: string; zh: string; file: string }) {
  const zhFontName = normalizeFontFamilyName(fonts.zh);
  const zhFamily = toCssFontFamily(zhFontName);
  const zhSubsetFamily = toCssFontFamily(`${zhFontName} UI Subset`);
  const enFamily = toCssFontFamily(fonts.en);
  const codeFontName = normalizeFontFamilyName(fonts.code);
  const codeFamily = toCssFontFamily(fonts.code);
  const monacoFontFace =
    codeFontName === 'Monaco'
      ? `@font-face{font-family:"Monaco";src:url(${toCssString(resolveAssetUrl('/fonts/Monaco.ttf'))}) format("truetype");font-style:normal;font-weight:400;font-display:swap;}`
      : '';
  // Traditional Chinese system fonts shown while the web font is still loading.
  const cjkSystemFallback = `--font-cjk-system:${enFamily},"PingFang TC","Microsoft JhengHei","Noto Sans TC",system-ui,sans-serif;`;

  // No file: the zh font ships as unicode-range slices from src/styles/fonts.css,
  // so there is no single full file and no UI subset to declare.
  if (!fonts.file) {
    return `
${monacoFontFace}
html:root{--font-config-en:${enFamily};--font-config-code:${codeFamily};--font-config-zh:${zhFamily};--font-config-zh-subset:${zhFamily};${cjkSystemFallback}}
`;
  }

  const fontFile = toCssString(resolveAssetUrl(fonts.file));
  const subsetUrl = getSubsetFontUrl(fonts.file);
  const subsetFile = toCssString(resolveAssetUrl(subsetUrl));

  return `
@font-face{font-family:${zhSubsetFamily};src:url(${subsetFile}) format("${getFontFormat(subsetUrl)}");font-style:normal;font-weight:400;font-display:swap;}
@font-face{font-family:${zhFamily};src:url(${fontFile}) format("${getFontFormat(fonts.file)}");font-style:normal;font-weight:400;font-display:swap;}
${monacoFontFace}
html:root{--font-config-en:${enFamily};--font-config-code:${codeFamily};--font-config-zh:${zhFamily};--font-config-zh-subset:${zhSubsetFamily};${cjkSystemFallback}}
`;
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<style is:inline set:html={fontVariablesCss}></style>
<ClientRouter />
<script is:inline>
  (() => {
    const storageKey = 'navfolio-theme';
    const root = document.documentElement;
    const themeMeta = () => document.querySelector('meta[name="theme-color"]');
    const systemTheme = () =>
      window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    const storedTheme = () => {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };
    const setStoredTheme = (theme) => {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {}
    };
    const applyTheme = (theme, persist = true) => {
      const nextTheme = theme === 'dark' ? 'dark' : 'light';
      const toggleLabel = nextTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';

      root.dataset.theme = nextTheme;
      root.style.colorScheme = nextTheme;
      themeMeta()?.setAttribute('content', nextTheme === 'dark' ? '#171b18' : '#fdfdf9');
      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', toggleLabel);
        button.setAttribute('title', toggleLabel);
      }
      if (persist) setStoredTheme(nextTheme);
      window.dispatchEvent(
        new CustomEvent('navfolio:theme-change', { detail: { theme: nextTheme } }),
      );
    };
    const syncThemeControls = () => {
      applyTheme(root.dataset.theme || storedTheme() || systemTheme(), false);
    };

    applyTheme(storedTheme() || systemTheme(), false);

    if (!window.__navfolioTheme) {
      window.__navfolioTheme = {
        toggle() {
          applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
        },
      };
    }

    if (window.__navfolioThemeInitialized) {
      syncThemeControls();
      return;
    }

    window.__navfolioThemeInitialized = true;

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest?.('[data-theme-toggle]');
      if (toggle) window.__navfolioTheme.toggle();
    });

    document.addEventListener('DOMContentLoaded', syncThemeControls, { once: true });
    document.addEventListener('astro:page-load', syncThemeControls);

    window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
      if (!storedTheme()) applyTheme(event.matches ? 'dark' : 'light', false);
    });
  })();
</script>
<link rel="icon" href={assetPath('favicon.svg')} sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href={assetPath('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={assetPath('favicon-16x16.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={assetPath('apple-touch-icon.png')} />
<link rel="manifest" href={assetPath('manifest.json')} />
<meta name="theme-color" content="#fdfdf9" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={site.title}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(imageUrl, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(imageUrl, Astro.url)} />

<!-- Analytics / search engine verification -->
<Analytics />
