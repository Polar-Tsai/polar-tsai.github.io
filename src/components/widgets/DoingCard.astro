---
import Icon from '../Icon.astro';
import FormattedDate from '../FormattedDate.astro';
import { getSiteConfig } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { RecentActivityItem, RecentActivityType } from '../../data/recent-activity';

const { items } = Astro.props as { items: RecentActivityItem[] };
const ui = getUiText(await getSiteConfig());
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

const typeIcon: Record<RecentActivityType, string> = {
  post: 'pen',
  vibe: 'sparkle',
  project: 'folder',
};

const typeLabel: Record<RecentActivityType, string> = {
  post: ui.search.resultKinds.blogNote,
  vibe: ui.search.resultKinds.vibe,
  project: ui.search.resultKinds.project,
};
---

<article class="glass-card doing-card">
  <h2><Icon name="calendar" /> {ui.doing.recently}</h2>
  {
    items.length < 3 ? (
      <p class="doing-empty">{ui.doing.empty}</p>
    ) : (
      <ul>
        {items.map((item) => (
          <li>
            <a class="doing-link" href={withBase(item.href)}>
              <span class="doing-type" data-type={item.type}>
                <Icon name={typeIcon[item.type]} size={14} />
                {typeLabel[item.type]}
              </span>
              <span class="doing-title">{item.title}</span>
              <span class="doing-date">
                <FormattedDate date={item.date} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .doing-card {
    padding: 24px 0 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .doing-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    color: var(--paper-ink);
    font-size: 1.06rem;
  }

  h2 svg {
    width: 21px;
    height: 21px;
    color: var(--paper-accent);
  }

  .doing-empty {
    margin: 0;
    padding: 14px 0 14px 18px;
    border-top: 1px solid var(--paper-line);
    color: var(--paper-ink-muted, var(--paper-ink));
    font-size: 0.94rem;
  }

  ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-top: 1px solid var(--paper-line);
  }

  .doing-link {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 14px 0 14px 18px;
    color: var(--paper-ink);
    font-size: 0.98rem;
    text-decoration: none;
  }

  .doing-link::before {
    position: absolute;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--paper-accent);
    content: '';
  }

  .doing-link:hover .doing-title {
    text-decoration: underline;
  }

  .doing-type {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--paper-accent-soft, var(--paper-line));
    color: var(--paper-accent);
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .doing-type svg {
    width: 13px;
    height: 13px;
  }

  .doing-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doing-date {
    font-size: 0.82rem;
    text-align: right;
    white-space: nowrap;
    opacity: 0.75;
  }
</style>
