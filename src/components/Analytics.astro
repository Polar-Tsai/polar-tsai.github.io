---
// Analytics and search-engine verification tags. Every id is optional in site.toml:
// an empty value means that tool is simply not loaded.
import { getSiteConfig } from '../data/site';

const { analytics } = await getSiteConfig();
// Keep dev/preview traffic out of the reports; verification tags stay on so they
// can be checked locally.
const trackingEnabled = import.meta.env.PROD;
const ga4Id = trackingEnabled ? analytics.ga4 : '';
const clarityId = trackingEnabled ? analytics.clarity : '';
const gtagSrc = ga4Id
  ? `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`
  : '';

// Script bodies are built as strings and injected with set:html, because a raw
// <script> inside an Astro expression cannot be parsed by Prettier.
const ga4Snippet = ga4Id
  ? `
window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }

// This inline script runs again after client-side navigations, so only set up once.
if (!window.__navfolioGa4Ready) {
  window.__navfolioGa4Ready = true;
  gtag('js', new Date());
  // Page views are sent from astro:page-load instead, which also covers
  // view-transition navigations that never reload the document.
  gtag('config', ${JSON.stringify(ga4Id)}, { send_page_view: false });

  document.addEventListener('astro:page-load', function () {
    gtag('event', 'page_view', {
      page_location: window.location.href,
      page_title: document.title,
    });
  });
}
`
  : '';

const claritySnippet = clarityId
  ? `
if (!window.clarity) {
  (function (c, l, a, r, i, t, y) {
    c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', ${JSON.stringify(clarityId)});
}
`
  : '';
---

{
  analytics.googleSiteVerification && (
    <meta name="google-site-verification" content={analytics.googleSiteVerification} />
  )
}
{
  analytics.bingSiteVerification && (
    <meta name="msvalidate.01" content={analytics.bingSiteVerification} />
  )
}
{gtagSrc && <script is:inline async src={gtagSrc} />}
{ga4Snippet && <script is:inline set:html={ga4Snippet} />}
{claritySnippet && <script is:inline set:html={claritySnippet} />}
